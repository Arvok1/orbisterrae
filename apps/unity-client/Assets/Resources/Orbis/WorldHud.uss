.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(223, 214, 190);
}

.top-bar {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 16px;
    height: 54px;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 10px;
    background-color: rgba(13, 17, 15, 0.91);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(77, 91, 74);
    border-right-color: rgb(77, 91, 74);
    border-top-color: rgb(77, 91, 74);
    border-bottom-color: rgb(77, 91, 74);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.world-title {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(203, 178, 117);
    margin-right: 22px;
}

.connection-status {
    font-size: 12px;
    color: rgb(164, 177, 159);
}

.session-label {
    font-size: 11px;
    color: rgb(190, 174, 132);
    margin-right: 6px;
}

.top-spacer {
    flex-grow: 1;
}

.hud-button {
    height: 34px;
    min-width: 142px;
    margin-left: 8px;
    color: rgb(228, 219, 194);
    background-color: rgb(40, 49, 42);
    border-left-color: rgb(100, 112, 91);
    border-right-color: rgb(100, 112, 91);
    border-top-color: rgb(100, 112, 91);
    border-bottom-color: rgb(100, 112, 91);
}

.hud-button:hover {
    background-color: rgb(57, 69, 57);
}

.hud-button.compact {
    min-width: 58px;
}

.world-info {
    position: absolute;
    left: 18px;
    top: 82px;
    width: 214px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(15, 20, 17, 0.86);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.modal-card,
.side-panel,
.event-panel {
    position: absolute;
    background-color: rgba(12, 17, 15, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(75, 91, 73);
    border-right-color: rgb(75, 91, 73);
    border-top-color: rgb(75, 91, 73);
    border-bottom-color: rgb(75, 91, 73);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    padding: 14px;
}

.modal-card {
    width: 360px;
    align-self: center;
    top: 30%;
}

.panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(211, 184, 116);
    margin-bottom: 5px;
}

.panel-help,
.inspector-text {
    font-size: 11px;
    color: rgb(166, 178, 160);
    white-space: normal;
    margin-bottom: 8px;
}

.primary-button {
    height: 34px;
    margin-top: 8px;
    color: rgb(237, 225, 190);
    background-color: rgb(73, 84, 61);
}

.panel-header,
.filter-row {
    flex-direction: row;
    align-items: center;
}

.filter-row > TextField {
    flex-grow: 1;
}

.live-badge {
    margin-left: auto;
    font-size: 10px;
    color: rgb(138, 213, 139);
}

.side-panel {
    top: 82px;
    bottom: 22px;
    width: 290px;
}

.left-panel {
    left: 18px;
}

.right-panel {
    right: 18px;
}

.section-title {
    margin-top: 9px;
    margin-bottom: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(204, 188, 148);
}

.item-list {
    flex-grow: 1;
    min-height: 80px;
}

.list-button,
.event-button {
    height: 48px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    font-size: 10px;
    white-space: normal;
    color: rgb(218, 209, 183);
    background-color: rgb(30, 39, 33);
}

.event-panel {
    right: 322px;
    bottom: 22px;
    width: 300px;
    height: 220px;
}

.event-list {
    flex-grow: 1;
}

.event-button {
    height: 42px;
}

.coordinates {
    font-size: 13px;
    color: rgb(219, 207, 176);
}

.altitude {
    margin-top: 4px;
    font-size: 12px;
    color: rgb(153, 170, 153);
}

.camera-hint {
    position: absolute;
    bottom: 18px;
    align-self: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(10, 13, 12, 0.78);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 11px;
    color: rgb(165, 178, 162);
}

.manuscript .top-bar,
.manuscript .world-info,
.manuscript .camera-hint,
.manuscript .modal-card,
.manuscript .side-panel,
.manuscript .event-panel {
    background-color: rgba(38, 28, 20, 0.91);
    color: rgb(231, 208, 158);
}

.compact-layout .top-bar {
    left: 8px;
    right: 8px;
    top: 8px;
    height: 48px;
    padding-left: 10px;
}

.compact-layout .world-title {
    font-size: 15px;
    margin-right: 0;
}

.compact-layout .connection-status {
    display: none;
}

.compact-layout .hud-button {
    min-width: 94px;
    font-size: 10px;
}

.compact-layout .world-info {
    left: 8px;
    top: 64px;
}

.compact-layout .camera-hint {
    display: none;
}

.compact-layout .side-panel {
    width: 250px;
}

.compact-layout .event-panel {
    display: none;
}
